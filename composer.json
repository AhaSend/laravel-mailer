{
    "name": "ahasend/laravel-mailer",
    "description": "AhaSend for Laravel 11, 12 and 13: API v2 and SMTP mail transports, and webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ahasend",
        "laravel",
        "mail",
        "mailer",
        "email",
        "transport",
        "api"
    ],
    "homepage": "https://github.com/AhaSend/laravel-mailer",
    "authors": [
        {
            "name": "AhaSend",
            "email": "support@ahasend.com"
        },
        {
            "name": "Aamir Yaqoob"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ahasend/symfony-mailer": "^1.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "AhaSend\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AhaSend\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhaSend\\Laravel\\AhaSendServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
